import SimpleGraph : 'SimpleGraph.ecore#/';
import SimpleGraph2Graph : 'SimpleGraph2Graph.ecore#/';

transformation Upper2Lower {
	upperGraph imports SimpleGraph;
	lowerGraph imports SimpleGraph;
	imports SimpleGraph2Graph;
}

/*Don't use realize keywords on the two initial domains indicates that both models must exist and at least have the root node defined?*/
map graph2graph in Upper2Lower {
	enforce upperGraph
	()
	{
		realize g1 : SimpleGraph::Graph[1]}
	enforce lowerGraph
	()
	{
		/*Enforced domains should at least have one realized variable?*/
		realize g2 : SimpleGraph::Graph[1]}
	where
	()
	{
		/*Although in the example is not realized, all middle model variables should be realized
		or does the middle model is also expected to have at least the initial element?*/
		realize g2g : SimpleGraph2Graph::Graph2Graph[1]
	|
		g2g.graph1 := g1;
		g2g.graph2 := g2;
	}
	map {
		where
		()
		{
			g2g.name := g1.name?.toLowerCase();
			g2g.name := g2.name?.toUpperCase();
			g1.name := g2g.name;
			g2.name := g2g.name;
		}
	}
}

map node2node in Upper2Lower {
	enforce upperGraph
	(
		g1 : SimpleGraph::Graph[1]
	)
	{
		realize n1 : SimpleGraph::Node[1]
	|
		n1.graph := g1;
	}
	enforce lowerGraph
	(
		g2 : SimpleGraph::Graph[1]
	)
	{
		realize n2 : SimpleGraph::Node[1]
	|
		n2.graph := g2;
	}
	where
	(
		g2g : SimpleGraph2Graph::Graph2Graph[1]
	|
		g2g.graph1 = g1;
		g2g.graph2 = g2;
	)
	{
		realize n2n : SimpleGraph2Graph::Node2Node[1]
	|
		n2n.owner := g2g;
		n2n.node1 := n1;
		n2n.node2 := n2;
	}
	map {
		where
		()
		{
			n2n.label := n1.label?.toLowerCase();
			n2n.label := n2.label?.toUpperCase();
			n1.label := n2n.label;
			n2.label := n2n.label;
		}
	}
}

map edge2edge in Upper2Lower {
	enforce upperGraph
	(
		g1 : SimpleGraph::Graph[1],
		sn1 : SimpleGraph::Node[1],
		tn1 : SimpleGraph::Node[1]
	)
	{
		realize e1 : SimpleGraph::Edge[1]
	|
		e1.graph := g1;
		e1.source := sn1;
		e1.target := tn1;
	}
	enforce lowerGraph
	(
		g2 : SimpleGraph::Graph[1],
		sn2 : SimpleGraph::Node[1],
		tn2 : SimpleGraph::Node[1]
	)
	{
		realize e2 : SimpleGraph::Edge[1]
	|
		e2.graph := g2;
		e2.source := sn2;
		e2.target := tn2;
	}
	where
	(
		g2g : SimpleGraph2Graph::Graph2Graph[1], sn2n : SimpleGraph2Graph::Node2Node[1], tn2n : SimpleGraph2Graph::Node2Node[1]
	|
		g2g.graph1 = g1;
		g2g.graph2 = g2;
		sn2n.owner = g2g;
		sn2n.node1 = sn1;
		sn2n.node2 = sn2;
		tn2n.node1 = tn1;
		tn2n.node2 = tn2;
	)
	{
		realize e2e : SimpleGraph2Graph::Edge2Edge[1]
	|
		e2e.owner := g2g;
		e2e.edge1 := e1;
		e2e.edge2 := e2;
		e2e.source := sn2n;
		e2e.target := tn2n;
	}
}
